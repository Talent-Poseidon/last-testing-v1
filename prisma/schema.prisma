// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NextAuth.js Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hashed password for Credentials provider
  role          String    @default("user") // "user" | "admin"
  is_approved   Boolean   @default(false)  // Approval logic replacement
  
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Master Data: Kamus (Dictionary of potensi & kompetensi)
model Kamus {
  id                   String   @id @default(cuid())
  code                 String   @unique
  name                 String
  type                 String   // "potensi" | "kompetensi"
  description          String   @db.Text
  behavioralIndicators String   @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdBy            String?
  updatedBy            String?

  standarJabatans StandarJabatanKamus[]
  scenarios       ScenarioKamus[]
}

model KamusEvent {
  id         String   @id @default(cuid())
  type       String   // "Kamus Submitted"
  payload    String   @db.Text
  occurredAt DateTime @default(now())
}

// Lightweight placeholder models to enforce kamus deletion-rejection.
// Full Standar Jabatan & Scenario epics will expand these later.
model StandarJabatan {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  kamus StandarJabatanKamus[]
}

model StandarJabatanKamus {
  standarJabatanId String
  kamusId          String
  expectedLevel    Int            @default(1)
  standarJabatan   StandarJabatan @relation(fields: [standarJabatanId], references: [id], onDelete: Cascade)
  kamus            Kamus          @relation(fields: [kamusId], references: [id])

  @@id([standarJabatanId, kamusId])
}

model Scenario {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("simulation")
  createdAt DateTime @default(now())

  kamus ScenarioKamus[]
}

model ScenarioKamus {
  scenarioId String
  kamusId    String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  kamus      Kamus    @relation(fields: [kamusId], references: [id])

  @@id([scenarioId, kamusId])
}

// Project Management Models
model Project {
  id            String   @id @default(cuid())
  name          String
  description   String   @db.Text
  configuration String   @db.Text // JSON config (e.g. {"kamusId":"...","standarJabatanId":"..."})
  status        String   @default("draft") // "draft" | "submitted"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?

  batches   Batch[]
  assessors ProjectAssessor[]
  events    ProjectEvent[]
}

model Batch {
  id        String   @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participants Participant[]
}

model Participant {
  id        String   @id @default(cuid())
  batchId   String
  name      String
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch       Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  invitations Invitation[]
}

model Invitation {
  id            String    @id @default(cuid())
  participantId String
  status        String    @default("sent") // "sent" | "accepted" | "expired"
  sentAt        DateTime  @default(now())
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

// Master data of available assessors
model Assessor {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  expertise String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects ProjectAssessor[]
}

model ProjectAssessor {
  projectId  String
  assessorId String
  assignedAt DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assessor Assessor @relation(fields: [assessorId], references: [id])

  @@id([projectId, assessorId])
}

model ProjectEvent {
  id         String   @id @default(cuid())
  projectId  String?
  type       String   // "Submit Project" | "Assessee Notified" | "Assessor Assigned"
  payload    String   @db.Text
  occurredAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
